{
  "name": "boardgames",
  "version": "1.0.0",
  "private": true,
  "description": "보드게임 - 친구들과 함께하는 온라인 보드게임 모음 (황야의 뱅, 밤의 저택, 바람섬 개척기, 보름밤의 늑대인간, 찬란한 보석상)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "assets:bang": "node bang/scripts/gen-assets.js",
    "assets:clue": "node mansion-clue/scripts/gen-assets.js",
    "sim:bang": "node bang/scripts/simulate.js",
    "sim:clue": "node mansion-clue/scripts/simulate.js",
    "assets:isle": "node isle/scripts/gen-assets.js",
    "sim:isle": "node isle/scripts/simulate.js",
    "assets:wolf": "node wolf/scripts/gen-assets.js",
    "sim:wolf": "node wolf/scripts/simulate.js",
    "assets:gem": "node gem/scripts/gen-assets.js",
    "sim:gem": "node gem/scripts/simulate.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "three": "^0.186.0"
  }
}
